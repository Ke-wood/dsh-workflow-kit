{
  "name": "@local/dsh-workflow-kit",
  "version": "2.3.0",
  "private": true,
  "description": "DSH 协作方法论套件：2 个入口模式（greenfield / brownfield）+ 可插拔模式库 + 8 个方法论 skill + 任务书模板与判决契约。判据常驻、路径按需、执行外包、判决可执行。",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "agent-preset",
    "skills",
    "workflow",
    "multi-agent"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:patch": "node scripts/gen-patch.mjs",
    "check:patch": "node scripts/gen-patch.mjs --check",
    "check:verdict": "python checks/verify.py --selftest",
    "check": "npm run check:patch && npm run check:verdict"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills/**",
    "modes/**",
    "roles/**",
    "templates/**",
    "checks/**",
    "personas/**",
    "scripts/**",
    "licenses/**",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
