{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ke-wood/dsh-workflow-kit/verdict.schema.json",
  "title": "Verdict",
  "description": "审查判决。主代理只读摘要一行；完整记录由 verify.py 落盘，按需调取。",
  "type": "object",
  "required": ["pass", "failed", "reviewed_at"],
  "additionalProperties": false,
  "properties": {
    "pass": {
      "type": "boolean",
      "description": "是否接受这份交付物。false 即打回。"
    },
    "failed": {
      "type": "array",
      "description": "失败项。pass=true 时必须为空数组。",
      "items": {
        "type": "object",
        "required": ["item", "impact", "repro"],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "description": "具体问题，必须指向可定位的位置（文件/函数/行）。"
          },
          "impact": {
            "type": "string",
            "enum": ["high", "med", "low"],
            "description": "high 必须由主代理亲自复核。"
          },
          "repro": {
            "type": "string",
            "description": "复现方式：命令，或可寻址的路径+行号。没有 repro 的失败项不可信。"
          }
        }
      }
    },
    "reviewed_at": {
      "type": "string",
      "description": "ISO 8601 时间戳。"
    },
    "reviewer": {
      "type": "string",
      "description": "审查者标识。必须独立于实现者。"
    },
    "checks": {
      "type": "array",
      "description": "可执行断言的执行结果。",
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "output_tail": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "交付物白名单。声明这次交付实际产出了哪些文件；verify.py 逐个检查存在性，有 sha256 则校验内容。空数组表示不声明，verify.py 会提示该判决未经交付物核验。",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "相对 verdict 文件所在目录，或相对 --root 指定目录。"
          },
          "sha256": {
            "type": "string",
            "description": "64 位小写十六进制。提供则校验内容，不提供只校验存在。"
          },
          "note": {
            "type": "string",
            "description": "这个文件证明了什么。一句话。"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "description": "变更范围。给出 base 与 allow 后，verify.py 会跑 git diff 检查实际改动是否越界。",
      "required": ["base", "allow"],
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string",
          "description": "git ref，如 HEAD、main、某个 commit。diff 从它开始算。"
        },
        "allow": {
          "type": "array",
          "description": "允许改动的路径前缀或 glob。空数组表示不允许任何改动。",
          "items": { "type": "string" }
        }
      }
    }
  }
}
