{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ke-wood/dsh-workflow-kit/verdict.schema.json",
  "title": "Verdict",
  "description": "审查判决。主代理只读 pass 与 failed[].impact，不读过程。",
  "type": "object",
  "required": ["pass", "failed", "reviewed_at"],
  "additionalProperties": false,
  "properties": {
    "pass": {
      "type": "boolean",
      "description": "是否接受这份交付物。false 即打回。"
    },
    "failed": {
      "type": "array",
      "description": "失败项。pass=true 时必须为空数组。",
      "items": {
        "type": "object",
        "required": ["item", "impact", "repro"],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "description": "具体问题，必须指向可定位的位置（文件/函数/行）。"
          },
          "impact": {
            "type": "string",
            "enum": ["high", "med", "low"],
            "description": "high 必须由主代理亲自复核。"
          },
          "repro": {
            "type": "string",
            "description": "复现方式：命令，或可寻址的路径+行号。没有 repro 的失败项不可信。"
          }
        }
      }
    },
    "reviewed_at": {
      "type": "string",
      "description": "ISO 8601 时间戳。"
    },
    "reviewer": {
      "type": "string",
      "description": "审查者标识。必须独立于实现者。"
    },
    "checks": {
      "type": "array",
      "description": "可执行断言的执行结果。",
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "output_tail": { "type": "string" }
        }
      }
    }
  }
}
